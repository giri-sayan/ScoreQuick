{
  "manifest_version": 3,
  "name": "ScoreQuick - Fastest Live Stats",
  "version": "1.2.0",
  "description": "Real-time live scores for Football, Cricket and Formula 1. Follow favorite teams and drivers with instant goal & wicket alerts.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ScoreQuick - Fastest Live Stats"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://www.fotmob.com/*",
    "https://*.fotmob.com/*",
    "https://static.flashscore.com/*",
    "https://*.flashscore.com/*",
    "https://images.onefootball.com/*",
    "https://*.onefootball.com/*",
    "https://www.indiansuperleague.com/*",
    "https://*.indiansuperleague.com/*",
    "https://crex.com/*",
    "https://*.crex.com/*",
    "https://crex.live/*",
    "https://api.goscorer.com/*",
    "https://*.crickapi.com/*",
    "https://site.web.api.espn.com/*",
    "https://site.api.espn.com/*",
    "https://*.espncdn.com/*",
    "https://*.espncricinfo.com/*",
    "https://*.cricinfo.com/*",
    "https://*.hscicdn.com/*",
    "https://*.imgci.com/*",
    "https://cricketvectors.akamaized.net/*",
    "https://documents.iplt20.com/*",
    "https://scores.iplt20.com/*",
    "https://storage.googleapis.com/*",
    "https://livetiming.formula1.com/*",
    "https://*.formula1.com/*",
    "https://api.jolpi.ca/*",
    "https://*.crash.net/*",
    "https://*.bbci.co.uk/*",
    "https://*.bbc.co.uk/*",
    "https://*.bbc.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
